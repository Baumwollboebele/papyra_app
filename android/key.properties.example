# Release signing configuration — TEMPLATE.
#
# Copy this file to `android/key.properties` and fill in your own values.
# key.properties and *.jks/*.keystore are gitignored: NEVER commit them.
#
# 1) Create an upload keystore (run once, from the repo root). Choose a strong
#    password and STORE IT SAFELY — losing it means you can only recover via
#    Google Play App Signing's upload-key reset.
#
#      keytool -genkey -v -keystore android/upload-keystore.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2) Enroll the app in Google Play App Signing (recommended) so Google manages
#    the app signing key and this keystore is only your *upload* key.
#
# 3) Fill in the four values below and save as android/key.properties.
#
# storeFile is resolved relative to android/app/, so a keystore at
# android/upload-keystore.jks is referenced as ../upload-keystore.jks.
# You may also use an absolute path.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=../upload-keystore.jks
